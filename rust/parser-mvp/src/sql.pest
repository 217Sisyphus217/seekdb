// Runtime grammar for the SELECT MVP. There is no SQL parser code generator.
query = { SOI ~ select ~ ";"? ~ EOI }
expression_input = { SOI ~ expression ~ EOI }

select = { SELECT ~ distinct? ~ projection ~ from_clause? ~ where_clause? ~ group_clause? ~ having_clause? ~ order_clause? ~ limit_clause? }
distinct = { DISTINCT }
projection = { select_item ~ ("," ~ select_item)* }
select_item = { expression ~ alias? }
alias = { AS? ~ identifier }
from_clause = { FROM ~ table ~ ("," ~ table)* }
table = { relation ~ join* }
relation = { (derived_table | qualified_name) ~ alias? }
derived_table = { "(" ~ select ~ ")" }
join = { outer_join_kind ~ JOIN ~ relation ~ join_condition | join_kind? ~ JOIN ~ relation ~ join_condition? }
outer_join_kind = { LEFT ~ OUTER? | RIGHT ~ OUTER? }
join_kind = { INNER | CROSS }
join_condition = { ON ~ expression | USING ~ "(" ~ identifier ~ ("," ~ identifier)* ~ ")" }
where_clause = { WHERE ~ expression }
group_clause = { GROUP ~ BY ~ expression_list }
having_clause = { HAVING ~ expression }
order_clause = { ORDER ~ BY ~ order_item ~ ("," ~ order_item)* }
order_item = { expression ~ direction? }
direction = { ASC | DESC }
limit_clause = { LIMIT ~ integer ~ (offset_clause | comma_limit)? }
offset_clause = { OFFSET ~ integer }
comma_limit = { "," ~ integer }

expression_list = { expression ~ ("," ~ expression)* }
expression = { or_expr }
or_expr = { xor_expr ~ (or_op ~ xor_expr)* }
xor_expr = { and_expr ~ (xor_op ~ and_expr)* }
and_expr = { not_expr ~ (and_op ~ not_expr)* }
not_expr = { not_op* ~ predicate }
predicate = { bit_or_expr ~ predicate_tail* }
predicate_tail = _{ comparison | between | in_list | like | is_test }
comparison = { compare_op ~ bit_or_expr }
between = { negated? ~ BETWEEN ~ bit_or_expr ~ AND ~ bit_or_expr }
in_list = { negated? ~ IN ~ "(" ~ (select | expression_list) ~ ")" }
like = { negated? ~ LIKE ~ bit_or_expr }
is_test = { IS ~ negated? ~ (null | boolean) }
negated = { NOT }
bit_or_expr = { bit_and_expr ~ (bit_or_op ~ bit_and_expr)* }
bit_and_expr = { shift_expr ~ (bit_and_op ~ shift_expr)* }
shift_expr = { sum_expr ~ (shift_op ~ sum_expr)* }
sum_expr = { product_expr ~ (sum_op ~ product_expr)* }
product_expr = { bit_xor_expr ~ (product_op ~ bit_xor_expr)* }
bit_xor_expr = { unary_expr ~ (bit_xor_op ~ unary_expr)* }
unary_expr = { unary_op* ~ atom }
atom = _{ nested | exists | function | qualified_wildcard | wildcard | number | string | null | boolean | parameter | qualified_name }
nested = { "(" ~ (select | expression) ~ ")" }
exists = { EXISTS ~ "(" ~ select ~ ")" }
function = { qualified_name ~ "(" ~ distinct? ~ expression_list? ~ ")" }
qualified_name = { identifier ~ ("." ~ identifier)* }
qualified_wildcard = { qualified_name ~ "." ~ "*" }
wildcard = { "*" }
parameter = { "?" }

or_op = { OR | "||" }
xor_op = { XOR }
and_op = { AND | "&&" }
not_op = { NOT }
compare_op = @{ "<=>" | "<=" | ">=" | "<>" | "!=" | "=" | "<" | ">" }
bit_or_op = @{ "|" ~ !"|" }
bit_and_op = @{ "&" ~ !"&" }
shift_op = @{ "<<" | ">>" }
sum_op = { "+" | "-" }
product_op = { "*" | "/" | "%" | DIV | MOD }
bit_xor_op = { "^" }
unary_op = { "+" | "-" | "!" | "~" }

identifier = _{ quoted_identifier | bare_identifier }
quoted_identifier = @{ "`" ~ ("``" | !"`" ~ ANY)+ ~ "`" }
bare_identifier = @{ !reserved ~ (ASCII_ALPHA | "_") ~ ident_continue* }
ident_continue = _{ ASCII_ALPHANUMERIC | "_" | "$" }
integer = @{ ASCII_DIGIT+ ~ !ident_continue }
number = @{ (ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? | "." ~ ASCII_DIGIT+) ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ !ident_continue }
string = @{ "'" ~ ("''" | "\\" ~ ("'" | "\\" | "n" | "r" | "t" | "0") | !("'" | "\\") ~ ANY)* ~ "'" }
null = { NULL }
boolean = { TRUE | FALSE }

reserved = _{ SELECT | DISTINCT | AS | FROM | WHERE | GROUP | BY | HAVING | ORDER | LIMIT | OFFSET | ASC | DESC | JOIN | INNER | LEFT | RIGHT | OUTER | CROSS | ON | USING | OR | XOR | AND | NOT | BETWEEN | IN | LIKE | IS | NULL | TRUE | FALSE | EXISTS | DIV | MOD | UNION }
SELECT = @{ ^"select" ~ !ident_continue }
DISTINCT = @{ ^"distinct" ~ !ident_continue }
AS = @{ ^"as" ~ !ident_continue }
FROM = @{ ^"from" ~ !ident_continue }
WHERE = @{ ^"where" ~ !ident_continue }
GROUP = @{ ^"group" ~ !ident_continue }
BY = @{ ^"by" ~ !ident_continue }
HAVING = @{ ^"having" ~ !ident_continue }
ORDER = @{ ^"order" ~ !ident_continue }
LIMIT = @{ ^"limit" ~ !ident_continue }
OFFSET = @{ ^"offset" ~ !ident_continue }
ASC = @{ ^"asc" ~ !ident_continue }
DESC = @{ ^"desc" ~ !ident_continue }
JOIN = @{ ^"join" ~ !ident_continue }
INNER = @{ ^"inner" ~ !ident_continue }
LEFT = @{ ^"left" ~ !ident_continue }
RIGHT = @{ ^"right" ~ !ident_continue }
OUTER = @{ ^"outer" ~ !ident_continue }
CROSS = @{ ^"cross" ~ !ident_continue }
ON = @{ ^"on" ~ !ident_continue }
USING = @{ ^"using" ~ !ident_continue }
OR = @{ ^"or" ~ !ident_continue }
XOR = @{ ^"xor" ~ !ident_continue }
AND = @{ ^"and" ~ !ident_continue }
NOT = @{ ^"not" ~ !ident_continue }
BETWEEN = @{ ^"between" ~ !ident_continue }
IN = @{ ^"in" ~ !ident_continue }
LIKE = @{ ^"like" ~ !ident_continue }
IS = @{ ^"is" ~ !ident_continue }
NULL = @{ ^"null" ~ !ident_continue }
TRUE = @{ ^"true" ~ !ident_continue }
FALSE = @{ ^"false" ~ !ident_continue }
EXISTS = @{ ^"exists" ~ !ident_continue }
DIV = @{ ^"div" ~ !ident_continue }
MOD = @{ ^"mod" ~ !ident_continue }
UNION = @{ ^"union" ~ !ident_continue }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
// Version comments and optimizer hints require semantics outside this MVP.
COMMENT = _{ "/*" ~ !("!" | "+") ~ (!"*/" ~ ANY)* ~ "*/" | ("--" ~ &(WHITESPACE | EOI) | "#") ~ (!NEWLINE ~ ANY)* }
